<!DOCTYPE html>
<html>
<head>
    <title>Apache Test Page</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        .container { max-width: 800px; margin: 0 auto; }
        .header { background: #4CAF50; color: white; padding: 20px; text-align: center; }
        .content { padding: 20px; border: 1px solid #ddd; margin-top: 20px; }
        .status { color: #4CAF50; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Apache Web Server is Running!</h1>
        </div>
        <div class="content">
            <p class="status">✅ Status: Online</p>
            <p>This Apache server was deployed automatically using Ansible role.</p>
            <p>Server: {{ ansible_hostname }}</p>
            <p>IP Address: {{ ansible_default_ipv4.address }}</p>
            <p>Timestamp: {{ ansible_date_time.iso8601 }}</p>
        </div>
    </div>
</body>
</html>